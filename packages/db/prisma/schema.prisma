generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  role      String    @default("operator")
  avatar    String?
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BusinessLine {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  icon               String
  color              String
  domain             String?
  isActive           Boolean             @default(true)
  managesAccounts    Boolean             @default(false)
  config             Json
  createdAt          DateTime            @default(now())
  clients            Client[]
  clientReports      ClientReport[]
  communications     Communication[]
  contracts          Contract[]
  invoices           Invoice[]
  leads              Lead[]
  marketingCampaigns MarketingCampaign[]
  marketingSegments  MarketingSegment[]
  marketingTemplates MarketingTemplate[]
  offers             Offer[]
  offerTemplates     OfferTemplate[]
  projects           Project[]
  savedViews         SavedView[]
  serviceTemplates   ServiceTemplate[]
  shortLinks         ShortLink[]
  contractTemplates  ContractTemplate[]
  commerceChannel      CommerceChannel?
  commerceListings     CommerceListing[]
  commercePricingRules CommercePricingRule[]
  commerceOrders       CommerceOrder[]
}

model Client {
  id                  String               @id @default(cuid())
  businessLineId      String
  entityType          String
  companyName         String
  cui                 String?
  regCom              String?
  contactPerson       String
  email               String
  phone               String?
  address             String?
  iban                String?
  bank                String?
  website             String?
  websites            String[]             @default([])
  status              String               @default("prospect")
  industry            String?
  notes               String?
  googleAdsCustomerId String?
  ga4PropertyId       String?
  gscSiteUrl          String?
  posthogProjectId    String?
  customFields        Json?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activities          Activity[]
  brandDNA            BrandDNA?
  businessLine        BusinessLine         @relation(fields: [businessLineId], references: [id])
  apiKeys             ClientApiKey[]
  domainConfigs       ClientDomainConfig[]
  clientReports       ClientReport[]
  communications      Communication[]
  connectedAccounts   ConnectedAccount[]
  contracts           Contract[]
  invoices            Invoice[]
  leads               Lead[]
  offers              Offer[]
  projects            Project[]
  retainers           Retainer[]
  seoAudits           SeoAudit[]
  systemAlerts        SystemAlert[]
  commerceOrders      CommerceOrder[]

  @@index([businessLineId, entityType])
  @@index([status])
}

model Lead {
  id              String         @id @default(cuid())
  businessLineId  String
  entityType      String
  companyName     String
  contactPerson   String
  email           String
  phone           String?
  status          String
  source          String?
  value           Float?
  probability     Float?
  priority        String?
  notes           String?
  customFields    Json?
  assignedTo      String?
  nextAction      String?
  nextActionDate  DateTime?
  convertedToId   String?
  externalId      String?
  externalSource  String?
  city            String?
  address         String?
  cui             String?
  website         String?
  county          String?
  industry        String?
  caenCode        String?
  caenDescription String?
  revenue         Float?
  employees       Int?
  companyStatus   String?
  foundedYear     Int?
  contactRole     String?
  phone2          String?
  phone3          String?
  email2          String?
  activityDomain  String?
  services        String?
  lastCampaignAt  DateTime?
  lastCampaignId  String?
  campaignCount   Int            @default(0)
  optOut          Boolean        @default(false)
  optOutAt        DateTime?
  sourcePage      String?
  sourceService   String?
  sourceDomain    String?
  sourceFormId    String?
  sourceReferrer  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  activities      Activity[]
  campaignLeads   CampaignLead[]
  businessLine    BusinessLine   @relation(fields: [businessLineId], references: [id])
  convertedTo     Client?        @relation(fields: [convertedToId], references: [id])

  @@unique([externalId, externalSource])
  @@index([businessLineId, entityType])
  @@index([status])
  @@index([industry])
  @@index([county])
  @@index([cui])
  @@index([sourcePage])
  @@index([sourceService])
  @@index([sourceDomain])
  @@index([utmSource])
}

model Project {
  id             String        @id @default(cuid())
  businessLineId String
  clientId       String
  templateId     String
  name           String
  status         String        @default("planificare")
  currentPhase   String?
  progress       Int           @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  budget         Float?
  assignedTo     String?
  notes          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  activities     Activity[]
  businessLine   BusinessLine  @relation(fields: [businessLineId], references: [id])
  client         Client        @relation(fields: [clientId], references: [id])
  systemAlerts   SystemAlert[]

  @@index([businessLineId, status])
}

model Offer {
  id             String          @id @default(cuid())
  number         String          @unique
  businessLineId String
  entityType     String
  clientId       String?
  entityName     String
  templateId     String
  templateName   String
  status         String          @default("draft")
  value          Float
  currency       String          @default("EUR")
  validUntil     DateTime?
  blocks         Json
  customFields   Json?
  modules        Json?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  createdBy      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activities     Activity[]
  contracts      Contract[]
  businessLine   BusinessLine    @relation(fields: [businessLineId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  deliveries     OfferDelivery[]

  @@index([businessLineId, status])
  @@index([clientId])
}

model OfferDelivery {
  id               String       @id @default(cuid())
  offerId          String
  token            String       @unique
  sentAt           DateTime     @default(now())
  sentTo           String
  sentBy           String
  emailSubject     String?
  emailMessage     String?
  pdfAttached      Boolean      @default(true)
  trackingEnabled  Boolean      @default(true)
  expiresAt        DateTime?
  firstOpenedAt    DateTime?
  lastOpenedAt     DateTime?
  totalViews       Int          @default(0)
  clientResponse   String?
  clientResponseAt DateTime?
  clientMessage    String?
  createdAt        DateTime     @default(now())
  offer            Offer        @relation(fields: [offerId], references: [id])
  events           OfferEvent[]

  @@index([offerId])
}

model OfferEvent {
  id         String        @id @default(cuid())
  deliveryId String
  type       String
  metadata   Json?
  ip         String?
  userAgent  String?
  device     String?
  timestamp  DateTime      @default(now())
  delivery   OfferDelivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, type])
  @@index([timestamp(sort: Desc)])
}

model Contract {
  id             String       @id @default(cuid())
  number         String       @unique
  businessLineId String
  offerId        String?
  clientId       String
  templateId     String
  sections       Json
  anexa2         Json?
  companyDetails Json
  clientDetails  Json
  status         String       @default("draft")
  value          Float
  currency       String       @default("EUR")
  duration       Int
  startDate      DateTime
  endDate        DateTime
  signedAt       DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  client         Client       @relation(fields: [clientId], references: [id])
  offer          Offer?       @relation(fields: [offerId], references: [id])
  invoices       Invoice[]

  @@index([businessLineId, status])
  @@index([clientId])
}

model Invoice {
  id                  String        @id @default(cuid())
  number              String        @unique
  businessLineId      String?
  clientId            String?
  extractedClientName String?
  extractedClientCui  String?
  contractId          String?
  type                String
  direction           String
  status              String        @default("emisa")
  amount              Float
  currency            String        @default("EUR")
  issuedAt            DateTime      @default(now())
  dueDate             DateTime
  paidAt              DateTime?
  items               Json
  notes               String?
  spvId               String?       @unique
  xmlData             String?
  source              String        @default("manual")
  extractionStatus    String        @default("confirmed")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  businessLine        BusinessLine? @relation(fields: [businessLineId], references: [id])
  client              Client?       @relation(fields: [clientId], references: [id])
  contract            Contract?     @relation(fields: [contractId], references: [id])

  @@index([businessLineId, status, direction])
  @@index([clientId])
}

model Retainer {
  id             String    @id @default(cuid())
  clientId       String
  businessLineId String
  serviceName    String
  amount         Float
  currency       String    @default("EUR")
  billingCycle   String    @default("lunar")
  status         String    @default("activ")
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id])

  @@index([businessLineId, status])
}

model Activity {
  id             String    @id @default(cuid())
  businessLineId String?
  userId         String?
  userName       String?
  action         String
  entityType     String
  entityId       String
  entityName     String
  details        Json?
  createdAt      DateTime  @default(now())
  clientId       String?
  leadId         String?
  projectId      String?
  offerId        String?
  contractId     String?
  client         Client?   @relation(fields: [clientId], references: [id])
  contract       Contract? @relation(fields: [contractId], references: [id])
  lead           Lead?     @relation(fields: [leadId], references: [id])
  offer          Offer?    @relation(fields: [offerId], references: [id])
  project        Project?  @relation(fields: [projectId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

model SavedView {
  id             String       @id @default(cuid())
  businessLineId String
  userId         String?
  name           String
  icon           String?
  color          String?
  filters        Json
  entityType     String       @default("lead")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])

  @@index([businessLineId, entityType])
}

model ServiceTemplate {
  id             String       @id @default(cuid())
  businessLineId String
  name           String
  shortName      String
  icon           String?
  description    String?
  category       String
  defaultPrice   Float
  pricingUnit    String
  setupFee       Float?
  currency       String       @default("EUR")
  includedWith   String[]
  defaultBlocks  Json?
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])

  @@index([businessLineId, isActive])
}

model OfferTemplate {
  id             String       @id @default(cuid())
  businessLineId String
  name           String
  description    String?
  serviceIds     String[]
  defaultBlocks  Json?
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])

  @@index([businessLineId, isActive])
}

model Communication {
  id             String        @id @default(cuid())
  businessLineId String?
  clientId       String?
  channel        String
  direction      String
  subject        String
  body           String
  fromAddr       String?
  toAddr         String?
  emailStatus    String?
  phone          String?
  callResult     String?
  duration       Int?
  meetingType    String?
  meetingUrl     String?
  participants   String[]      @default([])
  userId         String?
  userName       String?
  tags           String[]      @default([])
  attachments    String[]      @default([])
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])
  client         Client?       @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([businessLineId])
  @@index([channel])
  @@index([createdAt])
}

model UptimeCheck {
  id         String   @id @default(cuid())
  domain     String
  clientId   String?
  statusCode Int
  responseMs Int
  isUp       Boolean
  error      String?
  checkedAt  DateTime @default(now())

  @@index([domain, checkedAt(sort: Desc)])
  @@index([checkedAt(sort: Desc)])
}

model UptimeIncident {
  id          String    @id @default(cuid())
  domain      String
  clientId    String?
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  durationMin Int?
  cause       String?
  notified    Boolean   @default(false)

  @@index([domain, resolvedAt])
}

model MarketingSegment {
  id              String              @id @default(cuid())
  businessLineId  String
  name            String
  description     String?
  filters         Json
  excludedLeadIds Json?
  contactCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  campaigns       MarketingCampaign[]
  businessLine    BusinessLine        @relation(fields: [businessLineId], references: [id])

  @@index([businessLineId])
}

model MarketingTemplate {
  id             String              @id @default(cuid())
  businessLineId String
  name           String
  channel        String
  subject        String?
  body           String
  mediaUrl       String?
  mediaType      String?
  variables      String[]            @default([])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  campaigns      MarketingCampaign[]
  businessLine   BusinessLine        @relation(fields: [businessLineId], references: [id])

  @@index([businessLineId, channel])
}

model MarketingCampaign {
  id             String            @id @default(cuid())
  businessLineId String
  name           String
  channel        String
  campaignType   String            @default("outbound")
  segmentId      String?
  templateId     String
  status         String            @default("draft")
  scheduledAt    DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  socialConfig   Json?
  socialMetrics  Json?
  totalLeads     Int               @default(0)
  totalSent      Int               @default(0)
  totalOpened    Int               @default(0)
  totalConverted Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  campaignLeads  CampaignLead[]
  businessLine   BusinessLine      @relation(fields: [businessLineId], references: [id])
  segment        MarketingSegment? @relation(fields: [segmentId], references: [id])
  template       MarketingTemplate @relation(fields: [templateId], references: [id])
  shortLinks     ShortLink[]

  @@index([businessLineId, status])
  @@index([scheduledAt])
}

model CampaignLead {
  id             String            @id @default(cuid())
  campaignId     String
  leadId         String
  uniqueCode     String            @unique
  lpUrl          String?
  messageBody    String?
  sentAt         DateTime?
  lpOpenedAt     DateTime?
  lpOpenCount    Int               @default(0)
  lpTimeSpent    Int               @default(0)
  status         String            @default("pending")
  followUpSentAt DateTime?
  convertedAt    DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  campaign       MarketingCampaign @relation(fields: [campaignId], references: [id])
  lead           Lead              @relation(fields: [leadId], references: [id])

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
  @@index([uniqueCode])
}

model ShortLink {
  id             String             @id @default(cuid())
  code           String             @unique
  targetUrl      String
  title          String?
  clicks         Int                @default(0)
  businessLineId String
  campaignId     String?
  createdAt      DateTime           @default(now())
  businessLine   BusinessLine       @relation(fields: [businessLineId], references: [id])
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([businessLineId])
  @@index([code])
}

model BrandDNA {
  id        String   @id @default(cuid())
  clientId  String   @unique
  url       String
  name      String
  tagline   String?
  logoUrl   String?
  favicon   String?
  ogImage   String?
  logos     Json     @default("[]")
  colors    Json     @default("[]")
  fonts     Json     @default("[]")
  tone      Json
  audience  Json
  industry  String?
  category  String?
  keywords  String[] @default([])
  rawText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])
}

model CopilotConversation {
  id         String          @id @default(cuid())
  title      String?
  messages   Json
  pathname   String?
  tokenCount Int             @default(0)
  cost       Float           @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  actions    CopilotAction[]
}

model CopilotAction {
  id             String              @id @default(cuid())
  conversationId String
  actionType     String
  status         String              @default("pending")
  payload        Json
  reasoning      String?
  result         Json?
  approvedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime            @default(now())
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
}

model ClientReport {
  id              String              @id @default(cuid())
  token           String              @unique @default(cuid())
  businessLineId  String
  clientId        String
  domain          String?
  domainConfigId  String?
  title           String              @default("Raport Performanță")
  widgets         Json                @default("[]")
  notes           String?
  status          String              @default("active")
  showCostData    Boolean             @default(false)
  scheduleEnabled Boolean             @default(false)
  scheduleDay     Int?
  scheduleHour    Int?
  scheduleEmails  String?
  scheduleMessage String?
  sentAt          DateTime?
  viewedAt        DateTime?
  viewCount       Int                 @default(0)
  createdBy       String              @default("admin")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  businessLine    BusinessLine        @relation(fields: [businessLineId], references: [id])
  client          Client              @relation(fields: [clientId], references: [id])
  domainConfig    ClientDomainConfig? @relation(fields: [domainConfigId], references: [id])
  snapshots       ReportSnapshot[]

  @@index([clientId])
  @@index([token])
  @@index([domainConfigId])
}

model ClientDomainConfig {
  id                   String         @id @default(cuid())
  clientId             String
  domain               String
  googleAdsCustomerId  String?
  googleAdsCampaignIds String[]       @default([])
  gscSiteUrl           String?
  posthogProjectId     String?
  isActive             Boolean        @default(true)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  client               Client         @relation(fields: [clientId], references: [id])
  reports              ClientReport[]

  @@unique([clientId, domain])
  @@index([clientId])
}

model ReportSnapshot {
  id          String       @id @default(cuid())
  reportId    String
  dateFrom    DateTime
  dateTo      DateTime
  content     String
  highlights  Json?
  generatedBy String       @default("ai-copilot")
  createdAt   DateTime     @default(now())
  report      ClientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, dateFrom, dateTo])
  @@index([reportId, dateFrom])
}

model TenantInstance {
  id              String            @id @default(cuid())
  tenantId        String            @unique
  tenantName      String
  tenantSlug      String
  deploymentType  String            @default("shared")
  serverHost      String?
  serverPort      Int               @default(22)
  sshUser         String?
  sshPrivateKey   String?
  apiEndpoint     String?
  internalApiKey  String?
  status          String            @default("active")
  version         String?
  lastHeartbeat   DateTime?
  lastUpdate      DateTime?
  plan            String            @default("pro")
  licenseKey      String            @unique @default(cuid())
  gracePeriodDays Int               @default(7)
  updateWindow    String?
  autoUpdate      Boolean           @default(false)
  balanceCredits  Int               @default(0)
  accountingEmail String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  creditPackages  CreditPackage[]
  creditUsage     CreditUsage[]
  heartbeats      TenantHeartbeat[]
  anafSettings    AnafSettings?

  @@index([tenantSlug])
  @@index([status])
}

model CreditPricingRule {
  id              String   @id @default(cuid())
  serviceName     String   @unique
  costPerUnitEur  Float    @default(0)
  creditsPerUnit  Int      @default(1)
  unitDescription String
  updatedAt       DateTime @updatedAt
}

model CreditPackageConfig {
  id           String   @id @default(cuid())
  name         String
  priceEur     Float    @default(0)
  totalCredits Int      @default(0)
  createdAt    DateTime @default(now())
}

model CreditPackage {
  id          String         @id @default(cuid())
  instanceId  String
  type        String         @default("universal")
  packageName String
  credits     Int
  priceEur    Float
  costEur     Float
  status      String         @default("active")
  expiresAt   DateTime?
  purchasedAt DateTime       @default(now())
  instance    TenantInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, type])
  @@index([status])
}

model CreditUsage {
  id         String         @id @default(cuid())
  instanceId String
  type       String
  amount     Int
  detail     String?
  provider   String?
  rawCostUsd Float?
  metadata   Json?
  reportedAt DateTime       @default(now())
  instance   TenantInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, type, reportedAt])
  @@index([reportedAt(sort: Desc)])
}

model TenantHeartbeat {
  id            String         @id @default(cuid())
  instanceId    String
  version       String?
  uptime        Int?
  dbSize        String?
  activeUsers   Int?
  lastActivity  DateTime?
  aiTokensUsed  Int            @default(0)
  smsUsed       Int            @default(0)
  voiceMinutes  Float          @default(0)
  callMinutes   Float          @default(0)
  cpuPercent    Float?
  memoryPercent Float?
  diskPercent   Float?
  healthy       Boolean        @default(true)
  errors        Json?
  receivedAt    DateTime       @default(now())
  instance      TenantInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, receivedAt(sort: Desc)])
}

model SeoAudit {
  id        String   @id @default(cuid())
  domain    String
  clientId  String?
  score     Int
  results   Json
  summary   Json
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([domain, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
}

model ClientApiKey {
  id        String   @id @default(cuid())
  clientId  String
  key       String   @unique
  domain    String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([clientId])
  @@index([domain])
}

model ConnectedAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String?
  accessToken       String
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  email             String?
  clientId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([clientId])
}

model SystemAlert {
  id          String    @id @default(cuid())
  source      String    @default("posthog")
  title       String
  description String?
  url         String?
  domain      String?
  status      String    @default("new")
  severity    String    @default("medium")
  metadata    Json?
  clientId    String?
  projectId   String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client?   @relation(fields: [clientId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([clientId])
  @@index([projectId])
}

model Supplier {
  id                  String            @id @default(cuid())
  tenantId            String
  name                String
  cui                 String?
  vatNumber           String?
  country             String            @default("RO")
  vatRegime           String            @default("domestic") // domestic | intracommunity | extracommunity
  invoiceFetchMethod  String            @default("efactura") // efactura | email_parsing | api | manual
  invoiceSenderEmails String[]
  iban                String?
  category            String?
  isRecurring         Boolean           @default(false)
  expectedDay         Int?
  status              String            @default("active")
  createdAt           DateTime          @default(now())
  invoices            SupplierInvoice[]
  commerceFeeds       CommerceSupplierFeed[]

  @@index([tenantId])
}

model SupplierInvoice {
  id                       String                @id @default(cuid())
  tenantId                 String
  supplierId               String?
  extractedSupplierName    String?
  businessLineId           String?
  lines                    SupplierInvoiceLine[]
  amount                   Decimal
  currency                 String                @default("RON")
  issueDate                DateTime
  dueDate                  DateTime?
  invoiceNumber            String?
  contractReference        String?
  pdfUrl                   String
  receiptUrl               String?
  status                   String                @default("unpaid")
  source                   String // manual | email | api | spv
  spvId                    String?               @unique
  xmlData                  String?
  sourceRef                String?
  extractionStatus         String                @default("confirmed") // pending_review | confirmed
  extractedBy              String?
  createdAt                DateTime              @default(now())
  appliedRuleId            String?
  deductibilityOverride    Boolean               @default(false)
  expenseCategory          String?
  expenseDeductiblePercent Decimal?
  netAmount                Decimal?
  vatAmount                Decimal?
  vatDeductiblePercent     Decimal?
  vatRate                  Decimal?
  supplier                 Supplier?             @relation(fields: [supplierId], references: [id])
  payments                 SupplierPayment[]

  @@unique([supplierId, invoiceNumber])
  @@index([tenantId])
}

model SupplierPayment {
  id                String          @id @default(cuid())
  tenantId          String
  invoiceId         String
  amount            Decimal
  paidAt            DateTime
  method            String?
  createdAt         DateTime        @default(now())
  bankTransactionId String?
  matchedByUserId   String?
  invoice           SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
}

model BankConnection {
  id                      String   @id @default(cuid())
  tenantId                String
  bankName                String
  accountIban             String
  statementPasswordEnvKey String?
  createdAt               DateTime @default(now())

  @@index([tenantId])
}

model BankTransaction {
  id                String    @id @default(cuid())
  tenantId          String
  bankConnectionId  String
  date              DateTime
  description       String
  debit             Decimal   @default(0)
  credit            Decimal   @default(0)
  category          String?
  extractedMerchant String?
  matchedSupplierId String?
  matchedInvoiceId  String?
  matchStatus       String    @default("unmatched")
  extractionStatus  String    @default("confirmed")
  sourcePdfUrl      String
  sourceRef         String?
  dismissReason     String?
  dismissedAt       DateTime?
  dismissedBy       String?
  createdAt         DateTime  @default(now())

  @@index([tenantId])
}

model AccountingSettings {
  id              String    @id @default(cuid())
  tenantId        String
  accountantEmail String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  defaultVatRate  Decimal?
  isVatPayer      Boolean   @default(false)
  taxRate         Decimal?
  taxRegime       String?
  validFrom       DateTime  @default(now())
  validTo         DateTime?
  autoSendEnabled Boolean   @default(false)
  autoSendDay     Int       @default(5)

  @@index([tenantId])
}

model AccountingPackage {
  id           String   @id @default(cuid())
  tenantId     String
  month        String
  sentAt       DateTime @default(now())
  sentBy       String
  invoiceCount Int
  totalAmount  Decimal
  downloadUrl  String?
  status       String   @default("sent")

  @@index([tenantId])
}

model AnafSettings {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?
  updatedAt    DateTime  @updatedAt

  tenant TenantInstance @relation(fields: [tenantId], references: [id])
}

model SpvSyncLog {
  id               String    @id @default(cuid())
  tenantId         String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  daysRequested    Int
  status           String
  messagesFound    Int       @default(0)
  invoicesImported Int       @default(0)
  invoicesDeduped  Int       @default(0)
  errorMessage     String?
  triggeredBy      String?

  @@index([tenantId])
}

model DeductibilityRule {
  id                       String    @id @default(cuid())
  tenantId                 String
  name                     String
  supplierId               String?
  expenseCategory          String?
  vatDeductiblePercent     Decimal
  expenseDeductiblePercent Decimal
  validFrom                DateTime  @default(now())
  validTo                  DateTime?
  priority                 Int       @default(0)
  createdAt                DateTime  @default(now())

  @@index([tenantId])
}

model SupplierInvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  name        String
  description String?
  quantity    Decimal?
  unitPrice   Decimal?
  totalAmount Decimal
  periodStart DateTime?
  periodEnd   DateTime?

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  accountCode String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model ContractTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  isGlobal      Boolean        @default(true)
  businessLines BusinessLine[]
  sections      Json
  anexa2        Json?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model CompanySettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  name               String
  legalName          String
  regCom             String
  cif                String
  address            String
  iban               String?
  bank               String?
  representative     String?
  representativeRole String?
  email              String?
  phone              String?
  website            String?
  contractsConfig    Json?    // Pentru structura contracts din settings.json
  integrationsConfig Json?    // Pentru integrari (AI, SMSO, etc.)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

// ════════════════════════════════════════════════════════════════════
// COMMERCE MODULE (global catalog, activated per BusinessLine)
// All models below are additive — no changes to pre-existing tables.
// ════════════════════════════════════════════════════════════════════

// Per-BusinessLine commerce settings (activates the module for a BL)
model CommerceChannel {
  id               String       @id @default(cuid())
  businessLineId   String       @unique
  isEnabled        Boolean      @default(true)
  storefrontUrl    String?
  vatRate          Decimal      @default(21) @db.Decimal(5, 2)
  transportPct     Decimal      @default(0) @db.Decimal(6, 2) // landed-cost surcharge on supplier cost (%)
  defaultMarkupPct Decimal      @default(35) @db.Decimal(6, 2)
  minMarginRon     Decimal      @default(15) @db.Decimal(12, 2)
  roundingMode     String       @default("99") // 99 | 90 | integer | none
  config           Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  businessLine     BusinessLine @relation(fields: [businessLineId], references: [id], onDelete: Cascade)
}

// ─── Vehicles ───
model VehicleMake {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  logoUrl   String?
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  models    VehicleModel[]
}

model VehicleModel {
  id          String              @id @default(cuid())
  makeId      String
  slug        String
  name        String
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  make        VehicleMake         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  generations VehicleGeneration[]

  @@unique([makeId, slug])
}

model VehicleGeneration {
  id           String             @id @default(cuid())
  modelId      String
  slug         String
  name         String // display, e.g. "Logan III (2021-)"
  variant      String? // e.g. "MCV", "H/B", "2D"
  yearFrom     Int?
  yearTo       Int?
  chassisCodes String[]           @default([])
  bodyTypes    String[]           @default([])
  ktype        Int? // TecDoc type id (future)
  imageUrl     String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  model        VehicleModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fitments     CommerceFitment[]
  modelMaps    CommerceModelMap[]

  @@unique([modelId, slug])
}

// ─── Catalog ───
model CommerceCategory {
  id          String             @id @default(cuid())
  parentId    String?
  slug        String             @unique
  nameRo      String
  description String?
  bulkyClass  String             @default("standard") // small | standard | large | xlarge
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  parent      CommerceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    CommerceCategory[] @relation("CategoryTree")
  products    CommerceProduct[]
  groupMaps   CommerceGroupMap[]
  rules       CommercePricingRule[]
}

model CommerceSupplierFeed {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  supplierId       String?
  format           String // parser id, e.g. "gr-txt-v1"
  sourceType       String             @default("local") // local | ftp | url
  sourceConfig     Json // paths/urls (no secrets — credentials come from env)
  encoding         String             @default("ISO-8859-7")
  currency         String             @default("EUR")
  stockFlagMeaning String             @default("unknown") // unknown | one_in_stock | one_out_of_stock
  isActive         Boolean            @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  products         CommerceProduct[]
  runs             CommerceFeedRun[]
  groupMaps        CommerceGroupMap[]
  modelMaps        CommerceModelMap[]
}

model CommerceFeedRun {
  id          String               @id @default(cuid())
  feedId      String
  status      String               @default("running") // running | success | failed
  triggeredBy String?
  startedAt   DateTime             @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  stats       Json?
  error       String?
  feed        CommerceSupplierFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([feedId, startedAt(sort: Desc)])
}

model CommerceGroupMap {
  id         String               @id @default(cuid())
  feedId     String
  groupCode  String
  categoryId String?
  brand      String?
  quality    String? // OE | A | B | aftermarket
  updatedAt  DateTime             @updatedAt
  feed       CommerceSupplierFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  category   CommerceCategory?    @relation(fields: [categoryId], references: [id])

  @@unique([feedId, groupCode])
}

model CommerceModelMap {
  id           String               @id @default(cuid())
  feedId       String
  modelCode    String
  rawName      String
  generationId String?
  isManual     Boolean              @default(false)
  updatedAt    DateTime             @updatedAt
  feed         CommerceSupplierFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  generation   VehicleGeneration?   @relation(fields: [generationId], references: [id])

  @@unique([feedId, modelCode])
}

model CommerceProduct {
  id           String                    @id @default(cuid())
  feedId       String
  supplierCode String // supplier base article code
  groupCode    String?
  categoryId   String?
  nameEn       String
  nameEl       String?
  nameRo       String?
  nameRoSource String? // dict | ai | manual
  oeMain       String?
  side         String? // L | R
  brand        String?
  quality      String?
  attributes   Json?
  bulkyClass   String?
  images       String[]                  @default([])
  costPrice    Decimal                   @db.Decimal(12, 2)
  costCurrency String                    @default("EUR")
  contentHash  String?
  isActive     Boolean                   @default(true)
  firstSeenAt  DateTime                  @default(now())
  lastSeenAt   DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  feed         CommerceSupplierFeed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  category     CommerceCategory?         @relation(fields: [categoryId], references: [id])
  fitments     CommerceFitment[]
  oeCodes      CommerceOeCode[]
  stock        CommerceStock[]
  listings     CommerceListing[]
  links        CommerceProductLink[]     @relation("ProductLinkFrom")
  linkedFrom   CommerceProductLink[]     @relation("ProductLinkTo")
  competitors  CommerceCompetitorPrice[]

  @@unique([feedId, supplierCode])
  @@index([categoryId])
  @@index([oeMain])
  @@index([isActive])
  productImages CommerceProductImage[]
}

model CommerceFitment {
  id           String            @id @default(cuid())
  productId    String
  generationId String
  listingCode  String // supplier listing code (model+part)
  note         String?
  product      CommerceProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  generation   VehicleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([productId, generationId, listingCode])
  @@index([generationId])
  @@index([listingCode])
}

model CommerceOeCode {
  id         String          @id @default(cuid())
  productId  String
  raw        String
  normalized String
  product    CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalized])
  @@index([normalized])
}

model CommerceProductLink {
  id        String          @id @default(cuid())
  productId String
  relatedId String
  type      String          @default("equivalent")
  product   CommerceProduct @relation("ProductLinkFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   CommerceProduct @relation("ProductLinkTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
}

model CommerceStock {
  id        String          @id @default(cuid())
  productId String
  warehouse String
  rawFlag   Int
  updatedAt DateTime        @updatedAt
  product   CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouse])
}

model CommerceListing {
  id             String               @id @default(cuid())
  productId      String
  businessLineId String
  slug           String
  priceRon       Decimal?             @db.Decimal(12, 2)
  compareAtRon   Decimal?             @db.Decimal(12, 2)
  manualPriceRon Decimal?             @db.Decimal(12, 2)
  priceSource    String               @default("rule") // rule | competitor | manual
  appliedRuleId  String?
  priceUpdatedAt DateTime?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        CommerceProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessLine   BusinessLine         @relation(fields: [businessLineId], references: [id], onDelete: Cascade)
  appliedRule    CommercePricingRule? @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)

  @@unique([productId, businessLineId])
  @@unique([businessLineId, slug])
  @@index([businessLineId, isActive])
}

model CommercePricingRule {
  id                    String            @id @default(cuid())
  businessLineId        String
  name                  String
  priority              Int               @default(100) // higher wins
  categoryId            String?
  brand                 String?
  quality               String?
  costMin               Decimal?          @db.Decimal(12, 2) // in RON (landed cost)
  costMax               Decimal?          @db.Decimal(12, 2)
  markupPct             Decimal           @db.Decimal(6, 2)
  minMarginRon          Decimal?          @db.Decimal(12, 2)
  bulkySurchargeRon     Decimal           @default(0) @db.Decimal(12, 2)
  competitorUndercutRon Decimal?          @db.Decimal(12, 2)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  businessLine          BusinessLine      @relation(fields: [businessLineId], references: [id], onDelete: Cascade)
  category              CommerceCategory? @relation(fields: [categoryId], references: [id])
  listings              CommerceListing[]

  @@index([businessLineId, isActive])
}

model CommerceCompetitorPrice {
  id         String          @id @default(cuid())
  productId  String
  competitor String
  url        String?
  priceRon   Decimal         @db.Decimal(12, 2)
  inStock    Boolean?
  checkedAt  DateTime        @default(now())
  product    CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, competitor])
}

model CommerceTranslation {
  id         String   @id @default(cuid())
  hash       String
  sourceLang String   @default("en")
  targetLang String   @default("ro")
  sourceText String
  text       String
  source     String   @default("dict") // dict | ai | manual
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hash, targetLang])
  @@index([reviewed])
}

model CommerceExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Decimal  @db.Decimal(12, 6) // RON per 1 unit
  date      DateTime @db.Date
  source    String   @default("BNR")
  createdAt DateTime @default(now())

  @@unique([currency, date])
}

// ─── Orders (structure only in Phase 1) ───
model CommerceOrder {
  id                  String               @id @default(cuid())
  number              String               @unique
  businessLineId      String
  clientId            String?
  status              String               @default("new") // new | confirmed | ordered_supplier | shipped | delivered | cancelled | returned
  paymentMethod       String               @default("cod") // cod | card
  paymentStatus       String               @default("pending")
  currency            String               @default("RON")
  subtotal            Decimal              @db.Decimal(12, 2)
  shippingTotal       Decimal              @default(0) @db.Decimal(12, 2)
  vatTotal            Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  customer            Json
  shippingAddress     Json
  billingAddress      Json?
  notes               String?
  supplierOrderStatus String               @default("manual")
  idempotencyKey      String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  businessLine        BusinessLine         @relation(fields: [businessLineId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  items               CommerceOrderItem[]
  events              CommerceOrderEvent[]

  @@index([businessLineId, status])
  @@index([createdAt(sort: Desc)])
}

model CommerceOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  productId    String?
  listingId    String?
  supplierCode String
  name         String
  qty          Int
  unitPriceRon Decimal       @db.Decimal(12, 2)
  totalRon     Decimal       @db.Decimal(12, 2)
  costPrice    Decimal?      @db.Decimal(12, 2)
  generationId String?
  options      Json?
  order        CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Image references into the public bucket (CDN base from COMMERCE_IMAGES_CDN_BASE). Created via prisma/sql/commerce_product_image.sql.
model CommerceProductImage {
  id           String          @id @default(cuid())
  productId    String
  objectKey    String
  position     Int             @default(0)
  width        Int?
  height       Int?
  sizeBytes    Int?
  source       String          @default("auto") // auto | manual
  lastSeenAt   DateTime?
  missingSince DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, objectKey])
  @@index([productId, position])
  @@index([source, lastSeenAt])
}

model CommerceOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  type      String
  message   String?
  data      Json?
  createdAt DateTime      @default(now())
  order     CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Supplier price & stock sync (tables created via prisma/sql/commerce_supplier_sync.sql; FKs live in SQL only) ───
model CommerceSyncRun {
  id          String    @id @default(cuid())
  feedId      String
  job         String // feed_sync | reprice
  status      String    @default("running") // running | success | unchanged | aborted | failed
  dryRun      Boolean   @default(false)
  triggeredBy String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  stats       Json?
  error       String?
  alerted     Boolean   @default(false)

  @@index([feedId, startedAt(sort: Desc)])
}

model CommerceSyncFile {
  id          String   @id @default(cuid())
  feedId      String
  name        String
  remoteMtime DateTime
  size        Int
  sha256      String
  rows        Int
  appliedAt   DateTime

  @@unique([feedId, name])
}

model CommerceSyncReview {
  id           String    @id @default(cuid())
  feedId       String
  kind         String // price_change | new_product
  productId    String?
  supplierCode String
  status       String    @default("pending") // pending | approved | rejected
  oldCost      Decimal?  @db.Decimal(12, 2)
  newCost      Decimal?  @db.Decimal(12, 2)
  oldPriceRon  Decimal?  @db.Decimal(12, 2)
  newPriceRon  Decimal?  @db.Decimal(12, 2)
  changePct    Decimal?  @db.Decimal(10, 2)
  payload      Json?
  runId        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  decidedAt    DateTime?
  decidedBy    String?

  @@index([status, kind, createdAt(sort: Desc)])
  @@index([productId])
}

model CommerceSyncMissing {
  productId    String   @id
  feedId       String
  missingSince DateTime @default(now())
}
